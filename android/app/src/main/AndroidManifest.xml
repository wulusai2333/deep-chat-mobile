<?xml version="1.0" encoding="utf-8"?>
<!--
  应用清单 —— 安全相关的每一项都有硬性理由，改动前先读 docs/build.md。

  需求 §3 的硬约束（违反即返工）：
  1. android:allowBackup="false" + android:fullBackupContent="false"
     API Key 虽然由 Keystore 加密，但密文一旦被系统备份带到云端或另一台设备，
     就多了一条攻击面；而 Keystore 主密钥不可迁移，恢复后的密文只会永久不可解。
     两条一起关，既避免泄露也避免「恢复后 Key 失效」的困惑。
  2. android:usesCleartextTraffic="false" + networkSecurityConfig
     API 全部走 https。明文一律禁止 —— 将来若误加了 http 地址会立刻失败，
     而不是悄悄降级。
  3. 权限只有 INTERNET / RECORD_AUDIO / MODIFY_AUDIO_SETTINGS
     没有存储权限：导入 ZIP 用 SAF（系统文件选择器），保存备份用 MediaStore。
     见 native/file-open/README.md。第三个权限的必要性见下方 uses-permission 处的说明。
  4. android:dataExtractionRules（API 31+）同步关掉云备份与设备迁移
     allowBackup 在新系统上已被 dataExtractionRules 覆盖，必须两处都写。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限清单 —— 只有这三个，全部有据可查。

      INTERNET        与 api.deepseek.com 通信。
      RECORD_AUDIO    语音输入（getUserMedia）。危险权限，需运行时申请。
      MODIFY_AUDIO_SETTINGS
                      规格文档写的是"只申请 INTERNET 与 RECORD_AUDIO"，这里多了一个，
                      理由是可验证的、且不加就实现不了规格里的语音输入功能：

                      Capacitor 的 BridgeWebChromeClient.onPermissionRequest 处理
                      RESOURCE_AUDIO_CAPTURE 时，会同时向系统申请
                      MODIFY_AUDIO_SETTINGS 与 RECORD_AUDIO（见
                      node_modules/@capacitor/android/capacitor/src/main/java/
                      com/getcapacitor/BridgeWebChromeClient.java 第 108-109 行）。
                      它对返回结果做的是「全部 granted 才算 granted」的与运算。

                      如果 manifest 里没有声明 MODIFY_AUDIO_SETTINGS，系统会直接把它
                      判为 denied（不弹框、不给用户任何提示），于是整组请求
                      granted=false → request.deny() → 网页侧 getUserMedia 抛
                      NotAllowedError。用户看到的现象是"系统设置里麦克风明明允许了，
                      点录音就是失败"—— 极难排查。

                      它属于 normal 级权限：安装时自动授予，不弹授权框，
                      不在系统设置里单独列出，不给应用任何额外数据访问能力。
                      所以它不改变规格「不申请存储/位置等敏感权限」的本意，
                      只是补齐 WebView 录音链路的必要条件。

      显式不申请：任何存储权限（导入走 SAF，备份走 MediaStore）、
      CAMERA、位置、通讯录、电话状态。每次发布用 pnpm verify 复核。

      本次核对：android.permission.MODIFY_AUDIO_SETTINGS 的 protectionLevel
      为 normal（aapt2 dump permissions android.jar 可见），无需运行时申请。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      麦克风是可选能力：没有麦克风的设备仍应可安装。
      required="false" 让安装器不做硬性拦截。
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              「用其他应用打开 ZIP」—— 冷启动（onCreate）与热启动（onNewIntent）
              都会把 URI 交给 DeepChatFiles 插件。见 native/file-open/README.md。

              注意 <data> 的语义：同一个 <data> 里的多个属性是「与」，
              多个 <data> 之间是「或」。所以 scheme 与 mimeType 必须写在同一行，
              否则会变成「任意 content:// 或 任意 zip」—— 等于注册成万能查看器。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:mimeType="application/zip" />
                <data
                    android:scheme="content"
                    android:mimeType="application/x-zip-compressed" />
            </intent-filter>

            <!-- 分享一个 ZIP 到本应用（例如从聊天软件「分享 → Chat Demo」） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
